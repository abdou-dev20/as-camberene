{
  "name": "asc-camberene-server",
  "version": "1.0.0",
  "description": "API éditoriale et comptes du site ASC Cambérène",
  "private": true,
  "main": "dist/index.js",
  "scripts": {
    "dev": "nodemon --exec ts-node src/index.ts",
    "build": "npm run build:api && npm run build:scripts",
    "build:api": "tsc -p tsconfig.build.json",
    "build:scripts": "tsc -p tsconfig.scripts.json",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "create:superadmin": "node scripts/run.js create-user --role superadmin",
    "create:admin": "node scripts/run.js create-user --role admin",
    "create:user": "node scripts/run.js create-user",
    "bootstrap:admins": "node scripts/run.js bootstrap-admins",
    "seed": "node scripts/run.js seed-site",
    "recount:stats": "node scripts/run.js recount-stats"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^7.4.0",
    "helmet": "^7.1.0",
    "joi": "^17.13.3",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.6.0",
    "morgan": "^1.10.0",
    "multer": "^1.4.5-lts.1"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/morgan": "^1.9.9",
    "@types/multer": "^1.4.11",
    "@types/node": "^20.14.0",
    "nodemon": "^3.1.4",
    "ts-node": "^10.9.2",
    "tsx": "^4.23.13",
    "typescript": "^5.5.4"
  }
}
