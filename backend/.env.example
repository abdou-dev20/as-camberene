# ==========================================================================
# API du site ASC Cambérène
# ==========================================================================
PORT=4100
NODE_ENV=development

# Nombre de reverse proxys devant le serveur : 0 en direct, 1 derrière un
# Apache, 2 derrière l'Apache de l'hôte puis celui du conteneur. Sans lui, la
# limite de débit compte toutes les requêtes comme venant d'un seul visiteur.
TRUST_PROXY=0

# Base de données propre au site — distincte de celle de fconnect.
MONGODB_URI=mongodb://127.0.0.1:27017/asc_camberene

# Secrets de signature des jetons. À changer en production, et à ne jamais
# committer : deux valeurs distinctes, longues et tirées au hasard.
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=changez-cette-valeur-en-production
JWT_REFRESH_SECRET=changez-aussi-celle-ci-en-production
JWT_ACCESS_TTL=2h
JWT_REFRESH_TTL=30d

# Adresse publique du site, utilisée par les pages d'aperçu de partage
# (Facebook, WhatsApp, X) pour composer les liens et les adresses d'images.
# À défaut, la première origine de CORS_ORIGINS fait l'affaire.
SITE_URL=http://localhost:5173

# Origines autorisées à appeler l'API, séparées par des virgules.
# En développement, toute origine localhost est admise en plus de cette liste :
# le serveur de Vite change de port dès que le précédent est occupé.
# En production, cette liste fait seule autorité — y mettre le domaine du site.
CORS_ORIGINS=http://localhost:5173,http://localhost:4173
# En production, le site et l'API partagent le domaine — Apache transmet /api —
# et cette liste ne sert qu'aux éventuels appels depuis un autre outil :
#   CORS_ORIGINS=https://ascamberene.sn,https://www.ascamberene.sn

# Dossier de stockage des images téléversées depuis l'administration.
UPLOAD_DIR=uploads
UPLOAD_MAX_BYTES=157286400

# Dons en ligne par PayTech (https://paytech.sn → Paramètres → API).
# Sans clés, le site fonctionne et la page des dons annonce qu'ils ne sont pas
# encore ouverts. PAYTECH_ENV=test simule les paiements ; passer à prod une
# fois le compte marchand activé par PayTech.
PAYTECH_API_KEY=
PAYTECH_API_SECRET=
PAYTECH_ENV=test
