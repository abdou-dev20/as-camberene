# ==========================================================================
# Backend du site (backend/) — contenu éditorial, boutique, comptes
# ==========================================================================
# C'est lui qui fait vivre l'administration du site. Il est autonome :
# le lancer avec `cd backend && npm run dev`.
VITE_SITE_API_URL=http://localhost:4100

# ==========================================================================
# Backend fconnect — données sportives du club, en lecture seule
# ==========================================================================
# URL de la gateway fconnect (elle proxifie tous les microservices).
VITE_API_URL=http://localhost:4000

# Identifiant Mongo du club ASC Cambérène dans fconnect, obtenu à la création
# du compte club (fconnect/backend/services/auth-service : npm run create:club).
# Tant qu'il est vide, équipes, effectif et matchs viennent de src/data/.
VITE_CLUB_ID=
