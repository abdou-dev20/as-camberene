# Le site (fichiers statiques de dist/, hébergés chez LWS) et son API (Coolify)
# vivent sur deux domaines distincts : le domaine du site doit donc figurer
# dans CORS_ORIGINS côté API.
#
# Adresse inscrite dans le bundle à la construction : la changer impose de
# relancer `npm run build` et de renvoyer dist/.
VITE_SITE_API_URL=http://cy1ys485omwfmjqwnhesghqi.194.163.134.219.sslip.io

# Gateway fconnect. Laisser vide tant que la plateforme n'est pas jointe :
# équipes, effectif et matchs viennent alors de src/data/.
VITE_API_URL=

# Identifiant Mongo du club dans fconnect. Vide = données statiques.
VITE_CLUB_ID=
