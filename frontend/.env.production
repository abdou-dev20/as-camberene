# ==========================================================================
# Build de production du site
# ==========================================================================
# Le site et son API vivent sur le même domaine : Apache sert les fichiers
# statiques et transmet /api et /uploads au serveur Node. Une seule origine,
# donc aucun préflight CORS et aucun certificat supplémentaire.
VITE_SITE_API_URL=https://ascamberene.sn

# Gateway fconnect. Laisser vide tant que la plateforme n'est pas jointe :
# équipes, effectif et matchs viennent alors de src/data/.
VITE_API_URL=

# Identifiant Mongo du club dans fconnect. Vide = données statiques.
VITE_CLUB_ID=
