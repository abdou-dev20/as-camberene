# ==========================================================================
# Site ASC Cambérène — hébergement mutualisé Apache (LWS)
# ==========================================================================
# Copié tel quel dans dist/ par Vite. Équivalent, pour un hébergement sans
# accès à la configuration du serveur, de frontend/httpd-site.conf. Chaque bloc
# est conditionné à son module : un module absent fait sauter le bloc au lieu
# de rendre une erreur 500 sur tout le site.

Options -Indexes

# Application à page unique : toute route qui n'est pas un fichier rend
# index.html, et c'est le routeur du navigateur qui décide. Sans cela, un
# rechargement sur /admin/commandes donnerait un 404.
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^ index.html [L]
</IfModule>

<IfModule mod_headers.c>
    # index.html désigne la version des scripts : il ne doit jamais venir d'un
    # cache, sinon un visiteur garderait l'ancien site après un envoi.
    <FilesMatch "^index\.html$">
        Header set Cache-Control "no-cache, must-revalidate"
    </FilesMatch>

    # Les scripts et feuilles de style construits portent une empreinte dans
    # leur nom : un changement de contenu change le nom, ils peuvent donc être
    # gardés indéfiniment.
    <FilesMatch "-[A-Za-z0-9_-]{8}\.(js|css)$">
        Header set Cache-Control "public, max-age=31536000, immutable"
    </FilesMatch>

    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE \
        text/html text/plain text/css text/javascript \
        application/javascript application/json application/xml \
        image/svg+xml
</IfModule>
