[Unit]
Description=API du site ASC CambÃ©rÃ¨ne
Documentation=https://github.com/Diilaye/as-camberene
After=network-online.target mongod.service
Wants=network-online.target mongod.service

[Service]
Type=simple
User=www-data
Group=www-data

# Le serveur lit son .env depuis le dossier courant (dotenv) : c'est ce
# rÃ©pertoire de travail qui le lui donne, sans EnvironmentFile en double.
WorkingDirectory=/var/www/as-camberene/backend
ExecStart=/usr/bin/node dist/index.js

Restart=on-failure
RestartSec=5

# Un plantage au dÃ©marrage ne doit pas boucler indÃ©finiment : au-delÃ  de
# 5 tentatives en 60 s, le service reste arrÃªtÃ© et l'incident se voit.
StartLimitBurst=5
StartLimitIntervalSec=60

# Durcissement. `uploads` est le seul dossier oÃ¹ le service Ã©crit.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/www/as-camberene/backend/uploads

StandardOutput=journal
StandardError=journal
SyslogIdentifier=asc-camberene-api

[Install]
WantedBy=multi-user.target
