# ==========================================================================
# Pile Docker — à copier en .env.docker puis à renseigner
# ==========================================================================
# Ce fichier porte les secrets : il ne doit jamais rejoindre le dépôt.
#
#   cp .env.docker.example .env.docker
#   ./deploy/docker.sh up

# Adresse publique du site. Sert à la fois d'origine autorisée pour l'API et
# d'URL d'API inscrite dans le bundle du site.
SITE_URL=https://ascamberene.sn

# --------------------------------------------------------------------------
# Base de données — MongoDB Atlas
# --------------------------------------------------------------------------
# La chaîne se copie depuis Atlas : Database → Connect → Drivers.
#
#   mongodb+srv://<utilisateur>:<mot-de-passe>@<cluster>.mongodb.net/asc_camberene?retryWrites=true&w=majority
#
# Trois pièges :
#   • le nom de la base doit figurer dans l'URI, après le nom d'hôte — sans
#     lui, le serveur écrit dans « test » ;
#   • un mot de passe contenant @ : / ? # doit être encodé (%40, %3A…) ;
#   • l'IP du VPS doit être autorisée dans Atlas → Network Access, sinon la
#     connexion expire sans message explicite.
MONGODB_URI=

# Nom de la base, utilisé par la sauvegarde et la restauration.
MONGO_DB=asc_camberene

# Mettre 1 pour ajouter une base MongoDB en conteneur au lieu d'une base
# hébergée. MONGODB_URI est alors ignorée. Voir docker-compose.local-db.yml.
LOCAL_DB=0

# --------------------------------------------------------------------------
# Secrets de signature des jetons
# --------------------------------------------------------------------------
# Deux valeurs distinctes, longues, tirées au hasard :
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_TTL=2h
JWT_REFRESH_TTL=30d

# --------------------------------------------------------------------------
# Compte d'administration par défaut
# --------------------------------------------------------------------------
# Créé au démarrage de l'API s'il n'existe pas encore, avec le profil super
# administrateur. Un compte déjà en base n'est jamais modifié : le mot de passe
# changé depuis le site survit aux redéploiements. Laisser vide pour ne rien
# créer. Mot de passe : 10 caractères au moins.
DEFAULT_ADMIN_EMAIL=
DEFAULT_ADMIN_PASSWORD=
DEFAULT_ADMIN_NAME=

# --------------------------------------------------------------------------
# Dons en ligne — PayTech
# --------------------------------------------------------------------------
# Clés du compte marchand : paytech.sn → Paramètres → API. Laisser vide tant
# que le compte n'existe pas : la page des dons l'annonce, le reste du site
# fonctionne. PAYTECH_ENV=test simule les paiements ; prod une fois le compte
# activé par PayTech. Les notifications de paiement arrivent sur
# SITE_URL/api/donations/ipn, qui doit donc être en HTTPS.
PAYTECH_API_KEY=
PAYTECH_API_SECRET=
PAYTECH_ENV=test

# --------------------------------------------------------------------------
# Images sur RustFS (compatible S3) — facultatif
# --------------------------------------------------------------------------
# Les quatre premières vont ensemble. Toutes vides, les images restent dans le
# volume `uploads`. Utiliser un compte IAM limité au bucket, jamais les
# identifiants administrateur de RustFS.
S3_ENDPOINT=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_REGION=us-east-1

# --------------------------------------------------------------------------
# Divers
# --------------------------------------------------------------------------
# Port de la boucle locale vers lequel l'Apache de l'hôte transmet.
WEB_PORT=8080

# Gateway fconnect. Laisser vide tant que la plateforme n'est pas jointe :
# équipes, effectif et matchs viennent alors des données livrées avec le site.
FCONNECT_URL=
CLUB_ID=
